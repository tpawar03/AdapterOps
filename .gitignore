.DS_Store

# Python / uv
# venv/ (not .venv/) — UV_PROJECT_ENVIRONMENT=venv is set globally in ~/.zshenv;
# iCloud flags dot-prefixed dirs UF_HIDDEN, which silently breaks editable installs.
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# uv.lock IS committed — it is the reproducibility guarantee (see STATUS.md D15)

# Local model weights. Adapters are versioned as HF Hub revisions (PRD §9),
# not in git; checkpoints here are scratch.
checkpoints/
*.safetensors
*.bin

# Secrets — .env* so backups/variants (.env.bak, .env.local) can never be committed
.env
.env.*

# Generated by adapter-service-prd-build/build-offline.py — 3.6 MB of inlined
# fonts and mermaid, rebuilt from source.html on demand. Tracking it would add a
# fresh multi-megabyte blob to history on every PRD edit.
/adapter-service-prd.html

# Pinned adapters materialised on the rented box (adapterops.serve.launch).
# No leading dot, deliberately (D20).
_adapters/

# Frontier run lock (adapterops.router.frontier) — process-local, never committed.
data/router/frontier.lock

# Per-seed outputs from router seed studies. The committed record is
# runs/router__seed_study.json, which holds every seed's metrics; these are
# reproducible in minutes and would add a dozen parquets per study.
data/router/*__s[0-9]*.parquet
runs/router__train__*__s[0-9]*.json

# Judge labelling run lock (adapterops.judge.label) — process-local, never committed.
data/judge/judge.lock
